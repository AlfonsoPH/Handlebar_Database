<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CBAPDEV - Login</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="./css/style.css">
    <link rel="stylesheet" href="./css/login.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

    <!-- Navigation Bar -->
    <header class="navbar">
        <div class="nav-container">
            <a href="/home" class="brand-logo"> CBAPDEV </a>
            <nav class="nav-tabs">
                <a href="/login" class="nav-tab active">
                    <i class="fa-solid fa-right-to-bracket"></i> Login
                </a>
                <a href="/register" class="nav-tab">
                    <i class="fa-solid fa-user-plus"></i> Register
                </a>
            </nav>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="main-content">
        <div class="auth-card">
            <div class="auth-header">
                <h2>Welcome Back!</h2>
            </div>

            <form id="login-form" class="auth-form" method="post" action="login2" novalidate>
                <div class="form-group">
                    <label for="login-email">Email Address</label>
                    <div class="input-icon-wrapper">
                        <i class="fa-solid fa-envelope"></i>
                        <input type="email" id="login-email" name="login_email" required placeholder="lasalle@dlsu.edu.ph">
                    </div>
                </div>

                <div class="form-group">
                    <label for="login-password">Password</label>
                    <div class="input-icon-wrapper">
                        <i class="fa-solid fa-lock"></i>
                        <input type="password" id="login-password" name="login_password" required placeholder="••••••••">
                    </div>
                </div>

                <button type="submit" class="btn-primary">
                    <span>Sign In</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </form>

            <div class="auth-footer">
                Don't have an account? <a href="/register">Register now</a>
            </div>
        </div>
    </main>
</body>
</html>